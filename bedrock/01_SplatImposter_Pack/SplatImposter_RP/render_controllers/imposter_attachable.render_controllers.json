{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.imposter_attachable": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "uv_anim": {
        "offset": [
          "v.col / v.cols",
          "v.row / v.rows"
        ],
        "scale": [
          "1.0 / v.cols",
          "1.0 / v.rows"
        ]
      }
    }
  }
}
